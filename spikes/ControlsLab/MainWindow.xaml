<Window x:Class="ControlsLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ControlsLab"
        Title="Night Pursuit - Controls Lab (throwaway prototype)"
        Width="1280" Height="760" MinWidth="900" MinHeight="600"
        Background="Black" WindowStartupLocation="CenterScreen">
    <Grid>
        <local:GameView x:Name="Game" />
        <Border x:Name="TuningPanel" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,150,0,0" Width="330"
                Background="#E6060A10" BorderBrush="#00E5FF" BorderThickness="1" Padding="14,10">
            <StackPanel x:Name="TuningStack">
                <TextBlock Text="TUNING   (F12 or T closes)" Foreground="#00E5FF" FontFamily="Consolas"
                           FontWeight="Bold" FontSize="15" Margin="0,0,0,10" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
