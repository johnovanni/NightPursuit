<!-- Mission complete, game over and the finished-all screen: a title, a stack of lines and a key hint. A passive view. -->
<UserControl x:Class="NightPursuit.App.Screens.ResultScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False"
             FontFamily="{DynamicResource NeonFont}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1100" FontWeight="Bold"
                   FontSize="{DynamicResource TextTitle}" Foreground="{DynamicResource TextAmber}" />
        <StackPanel x:Name="LinesPanel" HorizontalAlignment="Center" Margin="0,24,0,0" />
        <TextBlock x:Name="KeyText" HorizontalAlignment="Center" Margin="0,36,0,0"
                   FontSize="{DynamicResource TextHeading}" Foreground="{DynamicResource TextCyan}" />
        <TextBlock x:Name="NoticeText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1100"
                   Margin="0,24,0,0" FontSize="{DynamicResource TextBody}" Foreground="{DynamicResource TextAmber}" />
    </StackPanel>
</UserControl>
