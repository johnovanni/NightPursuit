<!-- The high-score table; the entry just added says NEW and is cyan. A passive view. -->
<UserControl x:Class="NightPursuit.App.Screens.HighScoresScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False"
             FontFamily="{DynamicResource NeonFont}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="HIGH SCORES"
                   FontSize="{DynamicResource TextTitle}" Foreground="{DynamicResource TextAmber}" />
        <StackPanel x:Name="RowsPanel" HorizontalAlignment="Center" Margin="0,20,0,0" />
        <TextBlock x:Name="NoticeText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1100"
                   Margin="0,16,0,0" FontSize="{DynamicResource TextBody}" Foreground="{DynamicResource TextAmber}" />
        <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0" Text="ENTER  BACK TO TITLE"
                   FontSize="{DynamicResource TextBody}" Foreground="{DynamicResource TextCyan}" />
    </StackPanel>
</UserControl>
