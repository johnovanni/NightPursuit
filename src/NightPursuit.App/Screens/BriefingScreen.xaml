<!-- The mission briefing: a passive view of the flow's game. Nothing here takes focus; keys reach it only through ScreenFlow. -->
<UserControl x:Class="NightPursuit.App.Screens.BriefingScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NightPursuit.App.Screens"
             Focusable="False" IsTabStop="False"
             FontFamily="{DynamicResource NeonFont}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="MissionText" HorizontalAlignment="Center"
                   FontSize="{DynamicResource TextBody}" Foreground="{DynamicResource TextCyan}" />
        <TextBlock x:Name="TitleText" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,4,0,0"
                   FontSize="{DynamicResource TextHeading}" Foreground="{DynamicResource TextAmber}" />
        <TextBlock x:Name="BriefingText" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="900" Margin="0,12,0,0"
                   FontSize="{DynamicResource TextBody}" Foreground="{DynamicResource TextWhite}" />

        <!-- The boss: the picture beside its name, so the whole screen fits the design grid. -->
        <StackPanel x:Name="BossPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <local:BossPortrait x:Name="Portrait" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center" Margin="28,0,0,0" MinWidth="540">
                <TextBlock x:Name="BossNameText" FontWeight="Bold"
                           FontSize="{DynamicResource TextHeading}" Foreground="{DynamicResource TextWhite}" />
                <TextBlock x:Name="PhasesText" Margin="0,6,0,0" FontSize="{DynamicResource TextBody}" Foreground="{DynamicResource TextWhite}" />
                <TextBlock x:Name="MissileText" Margin="0,2,0,0" FontSize="{DynamicResource TextBody}" Foreground="{DynamicResource TextAmber}" />
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="NoBossText" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"
                   FontSize="{DynamicResource TextHeading}" Foreground="{DynamicResource TextWhite}" />

        <StackPanel HorizontalAlignment="Center" Margin="0,16,0,0">
            <TextBlock x:Name="LoadoutText" FontSize="{DynamicResource TextBody}" Foreground="{DynamicResource TextWhite}" />
            <TextBlock x:Name="RoadText" FontSize="{DynamicResource TextBody}" Foreground="{DynamicResource TextWhite}" />
            <TextBlock x:Name="TrafficText" FontSize="{DynamicResource TextBody}" Foreground="{DynamicResource TextWhite}" />
            <TextBlock x:Name="PoliceText" FontSize="{DynamicResource TextBody}" Foreground="{DynamicResource TextWhite}" />
            <TextBlock x:Name="ScoreText" Margin="0,8,0,0" FontSize="{DynamicResource TextBody}" Foreground="{DynamicResource TextCyan}" />
        </StackPanel>

        <TextBlock x:Name="KeysText" HorizontalAlignment="Center" Margin="0,18,0,0" Text="ENTER  DRIVE      ESC  QUIT      F1  CONTROLS"
                   FontSize="{DynamicResource TextBody}" Foreground="{DynamicResource TextGray}" />
        <TextBlock x:Name="NoticeText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1100"
                   Margin="0,12,0,0" FontSize="{DynamicResource TextBody}" Foreground="{DynamicResource TextAmber}" />
    </StackPanel>
</UserControl>
