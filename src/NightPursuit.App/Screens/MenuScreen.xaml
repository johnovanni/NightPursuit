<!-- Title, Pause, Settings and Quit: a passive view of the flow's menu. Nothing here takes focus; keys reach it only through ScreenFlow. -->
<UserControl x:Class="NightPursuit.App.Screens.MenuScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False"
             FontFamily="{DynamicResource NeonFont}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" HorizontalAlignment="Center" FontWeight="Bold"
                   FontSize="{DynamicResource TextTitle}" Foreground="{DynamicResource TextAmber}" />
        <StackPanel x:Name="LinesPanel" Margin="0,12,0,0" />
        <StackPanel x:Name="ItemsPanel" HorizontalAlignment="Center" Margin="0,36,0,0" />
        <TextBlock x:Name="NoticeText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1100"
                   Margin="0,36,0,0" FontSize="{DynamicResource TextBody}" Foreground="{DynamicResource TextAmber}" />
    </StackPanel>
</UserControl>
